# DraGold — environment. Copy to .env.local (gitignored) and fill in.

# --- Supabase / Postgres (required) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>       # server-side only, never ship to client
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>             # also read server-side by /api/ask for the
                                             # RLS-scoped `collection` tool

# --- Ask DraGold agent LLM ---
# The core is NOT bound to any vendor. Ollama is a complete, key-free path.
DRAGOLD_LLM_PROVIDER=ollama                   # ollama | gemini | anthropic
OLLAMA_BASE_URL=http://localhost:11434        # provider=ollama
DRAGOLD_LLM_MODEL=gpt-oss:20b                 # ollama: gpt-oss:20b (reliable tool calls) — llama3.2 is too weak
                                             # gemini default: gemini-2.0-flash
                                             # anthropic default: claude-haiku-4-5-20251001
# GEMINI_API_KEY=                             # required if DRAGOLD_LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=                          # required if DRAGOLD_LLM_PROVIDER=anthropic

# --- Ask DraGold rate limiting (/api/ask), all optional, window default 60s ---
# ASK_RL_WINDOW_S=60
# ASK_RL_GLOBAL=30                            # total calls / window across everyone
# ASK_RL_USER=8                               # per signed-in user / window
# ASK_RL_IP=5                                 # per anonymous IP / window (best-effort, in-memory)

# --- Optional integrations ---
# EBAY_CLIENT_ID=                             # live_market tool
# EBAY_CLIENT_SECRET=
# IMAGE_CACHE_KEY=
