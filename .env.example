# DraGold — environment. Copy to .env.local (gitignored) and fill in.

# --- Supabase / Postgres (required) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>   # server-side scripts only, never ship to client

# --- Vite client vars (local dev rendering) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Ask DraGold agent LLM (default: Ollama, fully self-hostable) ---
DRAGOLD_LLM_PROVIDER=ollama              # ollama | gemini | anthropic
OLLAMA_BASE_URL=http://localhost:11434
DRAGOLD_LLM_MODEL=llama3.1
# GEMINI_API_KEY=                        # only if DRAGOLD_LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=                     # only if DRAGOLD_LLM_PROVIDER=anthropic

# --- Optional integrations ---
# IMAGE_CACHE_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
